# Required in production. Fail-fast on startup if missing (APP_ENV=production).
# Long-lived OAuth2 token from https://www.dropbox.com/developers/apps
# Rotate annually. NEVER commit the populated .env to git.
DROPBOX_ACCESS_TOKEN=

# 32+ char random string — used to sign session cookies.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Runtime mode. "production" turns on fail-fast checks above + Secure cookies.
APP_ENV=development

# --- Backend wiring -------------------------------------------------------
APP_SECRET=change-me-to-a-random-string
DATABASE_URL=sqlite+aiosqlite:///data/finance.db
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
RECEIPT_STAGING_DIR=data/receipts
MAX_RECEIPT_UPLOAD_BYTES=10485760

# --- Dropbox layout -------------------------------------------------------
DROPBOX_ROOT_FOLDER=/finance-receipts
DROPBOX_BACKUP_FOLDER=/finance-backups/db
